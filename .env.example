# signal-rc-bot 設定例。cp .env.example .env して実値を埋める（.env は .gitignore 済み）。

# --- Signal（signal-cli-rest-api 経由）---
# bot がリンクしている Signal アカウントの電話番号 E.164
SIGNAL_NUMBER=+81XXXXXXXXXX
# bot 自身の UUID（エコー識別の参考用・任意）
SIGNAL_UUID=
# 操作を許可する送信者の UUID（カンマ区切りで複数可）。空だと起動拒否(fail-closed)
ALLOWED_UUIDS=
# signal-cli-rest-api のエンドポイント
SIGNAL_API=http://127.0.0.1:8081
SIGNAL_WS=ws://127.0.0.1:8081

# --- claude remote-control ---
# native install の claude 実行体（空ならOS別既定で解決）。例 C:\Users\<you>\.local\bin\claude.exe
RC_CLAUDE_PATH=
# RC の作業ディレクトリ（trust 承認済みの専用空フォルダ。機密を置かない）。例 C:\Users\<you>\rc-workspace
RC_WORKDIR=

# --- 挙動 ---
TRIGGER_WORDS=リモコン,remote,rc,remote control,リモートコントロール
URL_WAIT_MS=15000
HARD_IDLE_TIMEOUT_MS=1800000
MAX_CONCURRENT=5
SEND_TIMEOUT_MS=10000
