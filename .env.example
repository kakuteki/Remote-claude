# remote-claude 設定例。cp .env.example .env して実値を埋める（.env は .gitignore 済み）。

# === 共通（コア・チャットアプリ非依存）===
# 使用するチャットアダプタ: signal | fake |（自作アダプタ名）
CHAT_ADAPTER=signal
# 操作を許可する送信者ID（カンマ区切り）。Signal=sourceUuid / Telegram=from.id 等。空だと起動拒否(fail-closed)
ALLOWED_SENDERS=
# トリガ語（部分一致・カンマ区切り）
TRIGGER_WORDS=リモコン,remote,rc,remote control,リモートコントロール
# native install の claude 実行体（空ならOS別既定で解決）。例 C:\Users\<you>\.local\bin\claude.exe
RC_CLAUDE_PATH=
# RC の作業ディレクトリ（trust 承認済みの専用空フォルダ。機密を置かない）。例 C:\Users\<you>\rc-workspace
RC_WORKDIR=
URL_WAIT_MS=15000
HARD_IDLE_TIMEOUT_MS=1800000
MAX_CONCURRENT=5

# === adapter: signal（signal-cli-rest-api 経由）===
SIGNAL_NUMBER=+81XXXXXXXXXX
SIGNAL_API=http://127.0.0.1:8081
SIGNAL_WS=ws://127.0.0.1:8081
SEND_TIMEOUT_MS=10000

# === adapter: fake（SNS不要のテスト）===
# CHAT_ADAPTER=fake にして ALLOWED_SENDERS=fake-user とすると、stdin 入力でテストできる
# FAKE_SENDER_ID=fake-user
